{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qcpr://dataset-v2/query-record",
  "type": "object",
  "required": ["query_id", "text", "query_scope", "source_item_id", "positive_item_ids", "graded_relevance", "temporal_direction", "verification", "training_enabled", "split", "provenance"],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "query_scope": {"enum": ["exact", "semantic", "localized", "direction", "stable", "long_series"]},
    "source_item_id": {"type": "string", "minLength": 1},
    "positive_item_ids": {"type": "array", "minItems": 1},
    "graded_relevance": {"type": "object"},
    "temporal_direction": {"enum": ["forward", "reverse", "none"]},
    "localized_relation": {"type": ["object", "null"]},
    "verification": {"enum": ["human", "human_rewritten", "human_adjudicated", "generated_unverified", "rule_based_unverified", "derived_eval", "rejected"]},
    "training_enabled": {"type": "boolean"},
    "split": {"enum": ["train", "development", "test"]},
    "provenance": {"type": "object"}
  }
}
