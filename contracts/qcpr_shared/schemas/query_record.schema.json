{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QCPR query record",
  "type": "object",
  "required": ["query_id", "text", "query_scope", "positive_item_ids", "graded_relevance", "verification", "split"],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "query_scope": {"enum": ["exact", "semantic", "localized", "direction", "stable", "long_series"]},
    "positive_item_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "graded_relevance": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 3}},
    "verification": {"enum": ["human", "human_rewritten", "generated_verified", "generated_unverified", "derived_eval"]},
    "temporal_direction": {"enum": ["forward", "reverse", "none"]},
    "localized_relation": {"type": ["object", "null"]},
    "split": {"enum": ["train", "development", "test"]}
  },
  "additionalProperties": true
}
