{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QCPR retrieval item",
  "type": "object",
  "required": ["item_id", "item_type", "frames", "split", "source", "physical_group_id", "training_enabled"],
  "properties": {
    "item_id": {"type": "string", "minLength": 1},
    "item_type": {"enum": ["pair", "sequence"]},
    "frames": {"type": "array", "minItems": 2, "items": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 16},
        "timestamp": {"type": ["string", "number", "null"]},
        "sensor": {"type": ["string", "null"]},
        "gsd": {"type": ["number", "null"]}
      },
      "additionalProperties": true
    }},
    "split": {"enum": ["train", "development", "test"]},
    "source": {"type": "string", "minLength": 1},
    "physical_group_id": {"type": "string", "minLength": 1},
    "event_id": {"type": ["string", "null"]},
    "training_enabled": {"type": "boolean"}
  },
  "additionalProperties": true
}
