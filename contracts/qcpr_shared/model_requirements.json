{
  "evaluation_mask_sidecar": {
    "allowed_only_in_evaluation": [
      "mask_path",
      "dense_label_path",
      "official_label",
      "semantic_map"
    ],
    "join_key": "item_id"
  },
  "forbidden_primary_training_verification": [
    "generated_unverified",
    "derived_eval"
  ],
  "graded_relevance": {
    "0": "irrelevant",
    "1": "broad semantic match, diagnostic or low weight",
    "2": "same change category",
    "3": "same object, direction and damage/change type"
  },
  "localized_relation": {
    "optional_fields": [
      "relation_type",
      "normalized_box",
      "token_coordinates",
      "temporal_interval"
    ]
  },
  "long_series": {
    "minimum_frames": 3,
    "required_fields": [
      "sequence_id",
      "frame_ids",
      "timestamps",
      "query_temporal_extent"
    ]
  },
  "maximum_frames": 8,
  "minimum_frames": 2,
  "owner": "model",
  "query_scopes": [
    "exact",
    "semantic",
    "localized",
    "direction",
    "stable",
    "long_series"
  ],
  "required_fields": {
    "frame": [
      "path",
      "sha256"
    ],
    "item": [
      "item_id",
      "item_type",
      "frames",
      "split",
      "source",
      "physical_group_id",
      "training_enabled"
    ],
    "query": [
      "query_id",
      "text",
      "query_scope",
      "positive_item_ids",
      "graded_relevance",
      "verification",
      "split"
    ]
  },
  "required_timestamp_format": "ISO-8601 string or normalized float with explicit missingness",
  "schema_version": "1.0.0",
